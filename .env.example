# ============================================================
# TEIXEIRA STYLE — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o .env no Git.
# ============================================================

# Mercado Pago — Access Token (OBRIGATÓRIO)
# Obtenha em: https://www.mercadopago.com.br/developers/panel
# Em teste: começa com TEST-
# Em produção: começa com APP_USR-
MERCADOPAGO_ACCESS_TOKEN=TEST-SEU-TOKEN-AQUI

# Webhook URL (OPCIONAL)
# URL completa do endpoint de webhook no Vercel
# Exemplo: https://teixeira-style.vercel.app/api/mp-webhook
WEBHOOK_URL=https://SEU-DOMINIO.vercel.app/api/mp-webhook

# Firebase Project ID (usado pelo webhook para atualizar o Firestore)
FIREBASE_PROJECT_ID=teixeira-style

# Firebase Service Account Token (OPCIONAL)
# Necessário se o webhook precisar atualizar o Firestore com credenciais de serviço.
# Se omitido, o webhook ainda funciona mas sem atualizar o Firestore via REST.
# Configure via: https://console.firebase.google.com > Configurações > Contas de serviço
FIREBASE_SERVICE_ACCOUNT_TOKEN=
