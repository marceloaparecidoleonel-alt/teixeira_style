{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/mp-create-payment",
      "destination": "/api/mp-create-payment.js"
    },
    {
      "source": "/api/mp-payment-status",
      "destination": "/api/mp-payment-status.js"
    },
    {
      "source": "/api/mp-webhook",
      "destination": "/api/mp-webhook.js"
    },
    {
      "source": "/api/cancel-expired-orders",
      "destination": "/api/cancel-expired-orders.js"
    }
  ],
  "headers": [
    {
      "source": "/js/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "unsafe-none"
        }
      ]
    }
  ]
}
