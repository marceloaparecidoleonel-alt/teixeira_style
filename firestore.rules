rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------
    // Configurações da loja — leitura pública, escrita somente autenticado
    // -------------------------------------------------------
    match /store_settings/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // -------------------------------------------------------
    // Galeria — leitura pública, escrita somente autenticado
    // -------------------------------------------------------
    match /gallery/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // -------------------------------------------------------
    // Slides da Home — leitura pública, escrita somente autenticado
    // -------------------------------------------------------
    match /home_slides/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // -------------------------------------------------------
    // Produtos — leitura pública, escrita somente autenticado
    // Exceção: update do campo stock permitido sem auth (backend serverless)
    // -------------------------------------------------------
    match /products/{doc} {
      allow read:   if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null
                    || (request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['stock']));
    }

    // -------------------------------------------------------
    // Categorias — leitura pública, escrita somente autenticado
    // -------------------------------------------------------
    match /categories/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // -------------------------------------------------------
    // Carrinhos — cada usuário acessa apenas o próprio carrinho
    // -------------------------------------------------------
    match /carts/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == doc;
    }

    // -------------------------------------------------------
    // Clientes — somente autenticado
    // -------------------------------------------------------
    match /clients/{doc} {
      allow read, write: if request.auth != null;
    }

    // -------------------------------------------------------
    // Pedidos — somente autenticado
    // Exceção 1: update de campos de pagamento/status permitido sem auth (webhook)
    // Exceção 2: cliente autenticado pode ocultar SOMENTE o próprio pedido
    //            escrevendo hiddenBy[uid]:true — nenhum outro campo pode ser alterado
    // -------------------------------------------------------
    match /orders/{orderId} {
      allow read, create: if request.auth != null;

      // Admin / sistema autenticado: pode atualizar qualquer campo (igual ao original)
      allow update: if request.auth != null;

      // Webhook sem autenticação: apenas campos de pagamento/status e adminArchived
      allow update: if request.auth == null
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status','paymentStatus','paidAt',
                                 'stockDecremented','mercadopagoPaymentId',
                                 'paymentProvider','paymentMethod','externalReference',
                                 'cancelledAt','adminArchived','archived_at']);

      // Backend serverless (webhook/polling) sem Firebase Admin precisa ler o pedido
      // para verificar idempotência (stockDecremented, status atual).
      // Leitura sem auth é segura aqui pois orderId é UUID interno não-adivinável.
      allow read: if request.auth == null;

      allow delete: if request.auth != null;
    }

    // -------------------------------------------------------
    // Histórico de pedidos — somente autenticado
    // -------------------------------------------------------
    match /orders_history/{doc} {
      allow read, write: if request.auth != null;
    }

    // -------------------------------------------------------
    // Logs de atividade — leitura/escrita somente autenticado
    // -------------------------------------------------------
    match /activity_logs/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
